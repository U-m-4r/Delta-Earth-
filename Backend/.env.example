# NASA Earthdata Login bearer token used for Harmony requests.
# Never commit a real token. EDL_TOKEN is preferred; EARTHDATA_TOKEN is accepted for compatibility.
EDL_TOKEN=

# ASF CMR provisional GCOV collection (override to use beta release).
NISAR_GCOV_COLLECTION=C2854338529-ASF
HARMONY_BASE_URL=https://harmony.earthdata.nasa.gov
HARMONY_SUBMISSION_CONNECT_TIMEOUT_SECONDS=20
HARMONY_SUBMISSION_READ_TIMEOUT_SECONDS=180
CMR_BASE_URL=https://cmr.earthdata.nasa.gov/search
DATA_DIR=data
FRONTEND_ORIGIN=http://localhost:5173
MAX_POLYGON_AREA_KM2=100000
DISCOVERY_TIMEOUT_SECONDS=30
PROCESSING_TIMEOUT_SECONDS=1800
DOWNLOAD_TIMEOUT_SECONDS=300
